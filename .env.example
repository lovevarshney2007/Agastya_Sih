# ─────────────────────────────────────────────────────────────
# Agastya Frontend Environment Variables
# In Vite, variables exposed to the client MUST start with VITE_
# ─────────────────────────────────────────────────────────────

# URL of the deployed FastAPI Backend (without trailing slash)
# Local dev: http://localhost:8000
# Production: https://sih.monu14.me
VITE_API_BASE_URL=https://sih.monu14.me

# Optional: App Environment (development | staging | production)
VITE_APP_ENV=production
