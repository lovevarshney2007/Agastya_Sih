# ==============================================================================
# Agastya Frontend — Vite Environment Variables (.env.example)
# Copy this file to .env.local: `cp .env.example .env.local`
# ==============================================================================

# Backend API base URL for production/staging (defaults to local proxy in dev)
# Example: https://sih.monu14.me or https://api.yourdomain.com
VITE_API_BASE_URL=

# Development API proxy target (used by vite.config.ts)
VITE_DEV_API_TARGET=http://localhost:8000
