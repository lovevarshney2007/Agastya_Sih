# ==============================================================================
# AICTE APAAR National Ledger — Docker Environment Variables (.env.example)
# Copy this file to .env before starting docker compose: `cp .env.example .env`
# ==============================================================================

# Database Configuration
POSTGRES_DB=aicte_ledger
POSTGRES_USER=aicte_admin
POSTGRES_PASSWORD=aicte_production_secret_pass_2026
DB_PORT=5433

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security Keys (Replace with strong random strings in production)
ENCRYPTION_MASTER_KEY=aicte_master_secret_key_32_bytes_len_!
HMAC_BLIND_INDEX_KEY=aicte_salted_hmac_blind_index_key_32b!
JWT_SECRET_KEY=aicte_jwt_secure_signing_secret_key_12345!

# APAAR External Service Adapter Mode (mock | production)
APAAR_ADAPTER_MODE=mock

# Frontend & CORS Configuration
DEFAULT_FRONTEND_URL=https://team-agastya.vercel.app
CORS_ORIGINS=*,https://team-agastya.vercel.app,http://localhost:5173,http://localhost:3000
