# Vite exposes only variables that start with VITE_.

# Backend origin, without a trailing slash and without /api/v1.
# Leave unset in development: Vite proxies /api to http://localhost:8000.
# Production example: VITE_API_BASE_URL=https://api.example.gov.in
VITE_API_BASE_URL=

# Optional, development only: where the Vite proxy forwards /api (default http://localhost:8000)
# VITE_DEV_API_TARGET=http://localhost:8000
